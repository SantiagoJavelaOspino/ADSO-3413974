<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_SENA_GestionHorarios" targetNamespace="http://sena.edu.co/gestion-horarios" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_SENA_GestionHorarios" name="Sistema de Gestion de Horarios SENA" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Roles">
      <bpmn:lane id="Lane_Sistema" name="Sistema">
        <bpmn:flowNodeRef>Task_ValidarAcceso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Rol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidarConflictos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Conflicto</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Parametrizacion" name="Parametrizacion">
        <bpmn:flowNodeRef>Task_Param_GestionarParametros</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Param</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Soporte" name="Administrador de Soporte">
        <bpmn:flowNodeRef>Task_Soporte_GestionarSoporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Soporte</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Director" name="Director de Centro">
        <bpmn:flowNodeRef>Task_Director_ConsultarGestion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Director</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Aprendiz" name="Aprendiz">
        <bpmn:flowNodeRef>Task_Aprendiz_ConsultarHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Aprendiz</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Instructor" name="Instructor">
        <bpmn:flowNodeRef>Task_Instructor_ConsultarHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Instructor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinador" name="Coordinador Academico">
        <bpmn:flowNodeRef>Task_Ingresar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Coord_GestionarHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Coord_SeleccionarFicha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Coord_SeleccionarInstructor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Coord_SeleccionarAmbiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Coord_DefinirFechaHora</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Coord_CorregirHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Coordinador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_Inicio</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Inicio" name="Inicio" />
    <bpmn:userTask id="Task_Ingresar" name="Ingresar al sistema" />
    <bpmn:serviceTask id="Task_ValidarAcceso" name="Validar acceso y rol" camunda:type="external" camunda:topic="validar-acceso-rol" />
    <bpmn:exclusiveGateway id="Gateway_Rol" name="¿Que rol tiene el usuario?" />
    <bpmn:userTask id="Task_Coord_GestionarHorario" name="Gestionar horario" />
    <bpmn:userTask id="Task_Coord_SeleccionarFicha" name="Seleccionar ficha" />
    <bpmn:userTask id="Task_Coord_SeleccionarInstructor" name="Seleccionar instructor" />
    <bpmn:userTask id="Task_Coord_SeleccionarAmbiente" name="Seleccionar ambiente" />
    <bpmn:userTask id="Task_Coord_DefinirFechaHora" name="Definir fecha y hora" />
    <bpmn:serviceTask id="Task_ValidarConflictos" name="Validar conflictos de horario" camunda:type="external" camunda:topic="validar-conflictos-horario" />
    <bpmn:exclusiveGateway id="Gateway_Conflicto" name="¿Existe conflicto?" />
    <bpmn:userTask id="Task_Coord_CorregirHorario" name="Corregir horario" />
    <bpmn:serviceTask id="Task_RegistrarHorario" name="Registrar horario" camunda:type="external" camunda:topic="registrar-horario" />
    <bpmn:userTask id="Task_Instructor_ConsultarHorario" name="Consultar horario" />
    <bpmn:endEvent id="End_Instructor" name="Consulta finalizada" />
    <bpmn:userTask id="Task_Aprendiz_ConsultarHorario" name="Consultar horario" />
    <bpmn:endEvent id="End_Aprendiz" name="Consulta finalizada" />
    <bpmn:userTask id="Task_Director_ConsultarGestion" name="Consultar gestion de horarios" />
    <bpmn:endEvent id="End_Director" name="Consulta finalizada" />
    <bpmn:userTask id="Task_Soporte_GestionarSoporte" name="Gestionar soporte" />
    <bpmn:endEvent id="End_Soporte" name="Soporte finalizado" />
    <bpmn:userTask id="Task_Param_GestionarParametros" name="Gestionar parametrizacion" />
    <bpmn:endEvent id="End_Param" name="Parametrizacion finalizada" />
    <bpmn:endEvent id="End_Coordinador" name="Horario registrado" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Inicio" targetRef="Task_Ingresar" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Ingresar" targetRef="Task_ValidarAcceso" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ValidarAcceso" targetRef="Gateway_Rol" />
    <bpmn:sequenceFlow id="Flow_Rol_Coord" name="Coordinador Academico" sourceRef="Gateway_Rol" targetRef="Task_Coord_GestionarHorario">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rol == 'COORDINADOR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rol_Instructor" name="Instructor" sourceRef="Gateway_Rol" targetRef="Task_Instructor_ConsultarHorario">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rol == 'INSTRUCTOR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rol_Aprendiz" name="Aprendiz" sourceRef="Gateway_Rol" targetRef="Task_Aprendiz_ConsultarHorario">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rol == 'APRENDIZ'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rol_Director" name="Director de Centro" sourceRef="Gateway_Rol" targetRef="Task_Director_ConsultarGestion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rol == 'DIRECTOR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rol_Soporte" name="Administrador de Soporte" sourceRef="Gateway_Rol" targetRef="Task_Soporte_GestionarSoporte">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rol == 'SOPORTE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rol_Param" name="Parametrizacion" sourceRef="Gateway_Rol" targetRef="Task_Param_GestionarParametros">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${rol == 'PARAMETRIZACION'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C01" sourceRef="Task_Coord_GestionarHorario" targetRef="Task_Coord_SeleccionarFicha" />
    <bpmn:sequenceFlow id="Flow_C02" sourceRef="Task_Coord_SeleccionarFicha" targetRef="Task_Coord_SeleccionarInstructor" />
    <bpmn:sequenceFlow id="Flow_C03" sourceRef="Task_Coord_SeleccionarInstructor" targetRef="Task_Coord_SeleccionarAmbiente" />
    <bpmn:sequenceFlow id="Flow_C04" sourceRef="Task_Coord_SeleccionarAmbiente" targetRef="Task_Coord_DefinirFechaHora" />
    <bpmn:sequenceFlow id="Flow_C05" sourceRef="Task_Coord_DefinirFechaHora" targetRef="Task_ValidarConflictos" />
    <bpmn:sequenceFlow id="Flow_C06" sourceRef="Task_ValidarConflictos" targetRef="Gateway_Conflicto" />
    <bpmn:sequenceFlow id="Flow_C07" name="Si" sourceRef="Gateway_Conflicto" targetRef="Task_Coord_CorregirHorario">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${existeConflicto == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C08" sourceRef="Task_Coord_CorregirHorario" targetRef="Task_ValidarConflictos" />
    <bpmn:sequenceFlow id="Flow_C09" name="No" sourceRef="Gateway_Conflicto" targetRef="Task_RegistrarHorario">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${existeConflicto == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_C10" sourceRef="Task_RegistrarHorario" targetRef="End_Coordinador" />
    <bpmn:sequenceFlow id="Flow_I01" sourceRef="Task_Instructor_ConsultarHorario" targetRef="End_Instructor" />
    <bpmn:sequenceFlow id="Flow_A01" sourceRef="Task_Aprendiz_ConsultarHorario" targetRef="End_Aprendiz" />
    <bpmn:sequenceFlow id="Flow_D01" sourceRef="Task_Director_ConsultarGestion" targetRef="End_Director" />
    <bpmn:sequenceFlow id="Flow_S01" sourceRef="Task_Soporte_GestionarSoporte" targetRef="End_Soporte" />
    <bpmn:sequenceFlow id="Flow_P01" sourceRef="Task_Param_GestionarParametros" targetRef="End_Param" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_SENA">
    <bpmndi:BPMNPlane id="BPMNPlane_SENA" bpmnElement="Process_SENA_GestionHorarios">
